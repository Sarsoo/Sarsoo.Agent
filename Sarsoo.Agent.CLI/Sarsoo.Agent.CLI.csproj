<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>reeve</AssemblyName>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <PropertyGroup>
        <PublishAot>true</PublishAot>
        <PublishSelfContained>true</PublishSelfContained>
        <PublishTrimmed>true</PublishTrimmed>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
        <IsTrimmable>true</IsTrimmable>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <EnableAotAnalyzer>true</EnableAotAnalyzer>
        <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
        <OptimizationPreference>Speed</OptimizationPreference>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Release'" >
        <DebugSymbols>False</DebugSymbols>
        <DebugType>None</DebugType>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Agents.AI.Harness" Version="1.28.0" />
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
      <PackageReference Include="NLog" Version="6.2.2" />
      <PackageReference Include="NLog.Extensions.Logging" Version="6.3.0" />
      <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
      <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
      <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
      <PackageReference Include="Spectre.Console" Version="0.57.2" />
      <PackageReference Include="System.CommandLine" Version="3.0.0" />
      <PackageReference Include="Terminal.Gui" Version="2.6.0" />
      <PackageReference Include="Terminal.Gui.Editor" Version="2.5.7" />
    </ItemGroup>

    <ItemGroup>
        <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
        <EmbeddedResource Include="config.json" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Sarsoo.Agent.DevOps\Sarsoo.Agent.DevOps.csproj" />
      <ProjectReference Include="..\Sarsoo.Agent\Sarsoo.Agent.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>
    
</Project>
